# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sorch_ai

# Auth
SECRET_KEY=your-secret-key-here
AUTH_PROVIDER=stack  # or "none"

# Storage
S3_BUCKET=your-s3-bucket
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1

# Telephony
TELEPHONY_PROVIDER=cloudonix  # or "twilio"

# AI / LLM
OPENAI_API_KEY=your-openai-key

# Sentry (optional)
SENTRY_DSN=

# Deployment
DEPLOYMENT_MODE=local
APP_VERSION=dev

# Google Sheets (TODO: see approach/07_manual_setup.md)
# GOOGLE_SHEETS_CREDENTIALS=
